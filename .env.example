# Docs Share Configuration
# 自动生成于首次启动，或手动创建

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 基础配置
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 服务端口
PORT=3457

# API 认证密钥（自动生成或手动设置）
# 用于 REST API 上传/删除文档
# 首次启动会自动生成，请妥善保管
API_KEY=your-secret-api-key-here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 访问鉴权配置（默认启用，保护私有文档）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 是否启用前端访问鉴权（HTTP Basic Auth）
# 默认启用，保护私有文档
# 启用后，用户访问文档站需要输入用户名和密码
# 不影响 API 调用（API 仍然使用 Bearer Token）
# 如需公开访问，设置为 false
ENABLE_AUTH=true

# 授权用户列表（格式：user1:pass1,user2:pass2）
# 支持多用户，用逗号分隔
# ⚠️  请务必修改默认密码！
#
# 示例：
#   单用户：admin:your-secure-password-2026
#   多用户：alice:pass123,bob:pass456,admin:admin123
#
# 默认值：admin:admin（请修改！）
AUTH_USERS=admin:admin

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Git Webhook 配置（可选）
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 是否启用 Git Webhook
# 启用后，可以通过 POST /api/webhook 自动拉取更新
ENABLE_WEBHOOK=false

# Git 仓库路径（webhook 工作目录）
# 这是服务器上 Git 仓库的**绝对路径**，webhook 会在这里执行 git pull
#
# 示例场景：
#
# 场景 1: 独立文档仓库
# GIT_REPO_PATH=/home/user/my-docs
#
# 场景 2: Docker 容器（使用容器内路径）
# GIT_REPO_PATH=/app/docs
#
# 场景 3: 项目内文档
# GIT_REPO_PATH=/home/user/.docs-share
#
# 场景 4: 自定义位置
# GIT_REPO_PATH=/var/www/team-wiki
#
# 默认值: 项目根目录
# GIT_REPO_PATH=/path/to/your/repo

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 使用说明
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# 1. API_KEY 会在首次启动时自动生成
# 2. 如需手动生成强密钥：openssl rand -base64 32
# 3. Webhook 详细配置见：WEBHOOK-GUIDE.md
# 4. 本文件已在 .gitignore 中，不会被提交到 Git
