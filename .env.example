# Docs Share Configuration

# Server port
PORT=3457

# API Key for authentication (CHANGE THIS!)
# Used for uploading/deleting documents via API
API_KEY=your-secret-api-key-here

# Enable Git webhook for auto-pull on push
# Set to 'true' to enable webhook endpoint at /api/webhook
ENABLE_WEBHOOK=false

# Git repository path (for webhook)
# Defaults to the project directory
# GIT_REPO_PATH=/path/to/your/repo
